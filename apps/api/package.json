{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "node dist/main",
        "start:dev": "nest start --watch",
        "build": "nest build",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.0",
        "@nestjs/core": "^10.4.0",
        "@nestjs/platform-express": "^10.4.0",
        "@nestjs/config": "^3.2.0",
        "@nestjs/typeorm": "^10.0.2",
        "typeorm": "^0.3.20",
        "pg": "^8.12.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "class-validator": "^0.14.1",
        "class-transformer": "^0.5.1",
        "bcrypt": "^5.1.1",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.5",
        "@types/node": "^20.14.9",
        "@types/bcrypt": "^5.0.2",
        "@types/passport-jwt": "^4.0.1",
        "typescript": "^5.5.3",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.4",
        "@types/jest": "^29.5.12",
        "@nestjs/testing": "^10.4.0",
        "supertest": "^7.0.0",
        "@types/supertest": "^6.0.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
